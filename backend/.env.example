NODE_ENV=development
PORT=5000
# Legacy Express runtime only. The production migration target is Supabase Postgres.
MONGO_URI=mongodb://127.0.0.1:27017/kobo
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RATE_LIMIT_DISABLED=false
AUDIT_IP_SALT=replace-with-a-separate-random-secret
PLATFORM_FEE_BPS=500
OTP_PROVIDER=console
MOOLRE_ENV=sandbox
MOOLRE_API_USER=
MOOLRE_PUBLIC_KEY=
MOOLRE_PRIVATE_KEY=
MOOLRE_VAS_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_SENDER_ID=KOBO
# Sandbox only. Never enable in production.
MOOLRE_SANDBOX_SKIP_OTP=false
ADMIN_BOOTSTRAP_EMAIL=
